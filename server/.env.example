# Ejemplo sin secretos: copiar a .env local y completar fuera de Git.
# La aplicación Flutter solo conoce API_BASE_URL; nunca estas credenciales.
DB_PATH=./data/btohabitos.sqlite3
JWT_SECRET=
TOKEN_TTL_SECONDS=3600
ALLOWED_ORIGINS=http://127.0.0.1:18311,http://localhost:18311
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
