# Ejemplo sin secretos: copiar a .env local y completar fuera de Git.
# La aplicación Flutter solo conoce API_BASE_URL; nunca estas credenciales.
# La factory consume variables del entorno; NO carga archivos .env automáticamente.
# Valores relativos a server/ al ejecutar desde ese directorio.
# La API del laboratorio debe escuchar únicamente en 127.0.0.1:18310.
DB_PATH=./data/btohabitos.sqlite3
# Obligatorio: secreto aleatorio privado de al menos 32 bytes; sin valor por defecto.
# El backend rechaza un secreto vacío o demasiado corto al crear la aplicación.
JWT_SECRET=
# Alias legado: solo se lee si JWT_EXPIRES_SECONDS está ausente.
TOKEN_TTL_SECONDS=3600
# Nombre canónico del encargo: duración positiva del JWT, expresada en segundos.
JWT_EXPIRES_SECONDS=3600
# Lista separada por comas de orígenes locales explícitos; nunca usar *.
ALLOWED_ORIGINS=http://127.0.0.1:18311,http://localhost:18311
# Completar las tres variables únicamente en el entorno privado del servidor.
# Vacías: /asistente debe responder 503, sin respuestas simuladas.
# Base HTTPS de una API compatible con OpenAI; HTTP solo para proveedor local explícito.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Tiempo máximo de petición al proveedor, positivo y no superior a 30 segundos.
OPENAI_TIMEOUT_SECONDS=30
# Interruptor implementado exclusivamente en el adaptador del servidor.
# true añade thinking={"type":"disabled"} para Z.ai; false omite esa extensión.
# En ambos casos: response_format={"type":"json_object"}, stream=false, max_tokens=512.
OPENAI_DISABLE_THINKING=false
